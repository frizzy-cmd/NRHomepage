			"binding": "DB",
			"database_name": "forum-db",
			"database_id": "3b830a74-15a2-47cb-b696-21a2382fc1c7"
		}
	],
	"r2_buckets": [
		{
			"bucket_name": "forum-uploads",
			"binding": "UPLOADS"
		}
	]
}